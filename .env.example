# Copy to .env. Every setting is optional; defaults are shown.
VAULT_DATA_DIR=./data
VAULT_EMBED_MODEL=clip-b32
VAULT_MAX_UPLOAD_BYTES=52428800
VAULT_NEAR_DUP_COSINE=0.94
VAULT_NEAR_DUP_PHASH=6
# Only for local development on a trusted machine.
VAULT_AUTH_DISABLED=false

# docker-compose.prod.yml: the Docker network the reverse proxy lives on.
CADDY_NETWORK=waltadj_default

# Optional discovery sources.
# Free key from developers.giphy.com; without it Giphy is not offered.
VAULT_GIPHY_API_KEY=
VAULT_GIPHY_RATING=pg-13
